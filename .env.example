# =============================================================
# VITE — Variables de entorno
# Copiar este archivo como .env y completar con valores reales
# NUNCA subir .env al repositorio
# =============================================================

# --- Base de datos (usuario de la aplicación) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vite
DB_USER=vite
DB_PASSWORD=tu_password_aqui

# --- Pool de conexiones ---
DB_MIN_CONN=1
DB_MAX_CONN=10

# --- Superusuario PostgreSQL (solo para setup inicial) ---
DB_SUPERUSER=postgres
DB_SUPERUSER_PASSWORD=tu_password_superusuario_aqui
